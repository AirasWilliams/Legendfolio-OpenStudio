# Build-time process environment. The build does not automatically load .env files.
# Leave cloud disabled for a local-only instance.
LEGENDFOLIO_CLOUD_ENABLED=false
# Set true and supply all three values to enable connected features.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_KEY
# LEGENDFOLIO_SITE_URL=https://YOUR_APP_DOMAIN
# Never put secret/service-role keys or database credentials here.
